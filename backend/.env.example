# ---------------------------------------------------------------
# FutOwl backend · variables de entorno (copiar a .env)
# ---------------------------------------------------------------
DJANGO_SETTINGS_MODULE=config.settings.development
DJANGO_SECRET_KEY=cambie-esta-clave-por-una-larga-y-aleatoria-de-50-caracteres
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_ADMIN_URL=admin/

# Cifrado de datos sensibles (generar con:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
FIELD_ENCRYPTION_KEY=
BLIND_INDEX_KEY=
JWT_SIGNING_KEY=

# Base de datos: Supabase Postgres (usar el "connection pooler", puerto 6543)
# DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
DB_SSL_REQUIRE=false

# Supabase Storage (API S3) para logos, fotos y documentos
# SUPABASE_S3_ENDPOINT=https://<ref>.supabase.co/storage/v1/s3
# SUPABASE_S3_ACCESS_KEY=
# SUPABASE_S3_SECRET_KEY=
# SUPABASE_S3_BUCKET=futowl
# SUPABASE_S3_REGION=us-east-1

# CORS / CSRF (dominio del frontend)
CORS_ALLOWED_ORIGINS=http://localhost:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173

# Sesión
JWT_ACCESS_MINUTES=15
JWT_REFRESH_HOURS=12
AUTH_COOKIE_SAMESITE=Lax
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
